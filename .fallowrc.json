{
  "$schema": "https://docs.fallow.tools/schema/fallow.json",
  "ignoreDependencies": [
    "@op-engineering/op-sqlite",
    "expo-file-system",
    "expo-network",
    "expo-splash-screen",
    "react-native-get-random-values",
    "better-sqlite3",
    "ts-morph"
  ],
  "ignorePatterns": [
    "**/_generated/**",
    "packages/convex-embedded/consumer-types/**",
    "packages/convex-embedded/src/browser/sqlite/worker.js",
    "packages/convex-embedded/src/component/public/cleanup.ts",
    "packages/convex-embedded/src/component/public/marks.ts",
    "packages/convex-embedded/src/expo/shims/**",
    "packages/convex-embedded/src/utils/cache.ts",
