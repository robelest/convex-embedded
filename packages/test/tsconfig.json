{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@embedded/*": ["../convex-embedded/src/*"],
      "@resolve/*": ["../convex-embedded/src/*"],
      "@fx/*": ["../fx/src/*"],
      "@convex/*": ["../../convex/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
