{
  "name": "@robelest/fx",
  "version": "0.0.1-preview.2",
  "description": "Minimal functional effect system for TypeScript. Lazy Fx<A, E> computations with composable retry, resource management, and zero dependencies.",
  "keywords": [
    "composition",
    "effect",
    "functional",
    "fx",
    "result",
    "retry",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robelest/convex-embedded.git",
    "directory": "packages/fx"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp exec tsdown",
    "typecheck": "vp exec tsgo --noEmit",
    "test": "vp run --filter @robelest/embedded-tests test:fx",
    "test:once": "vp run --filter @robelest/embedded-tests test:fx",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
