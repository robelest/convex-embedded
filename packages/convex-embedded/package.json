{
  "name": "@robelest/convex-embedded",
  "version": "0.0.1",
  "description": "Embedded Convex runtime with offline-first sync for local-first applications.",
  "keywords": [
    "convex",
    "crdt",
    "embedded",
    "local-first",
    "offline-first",
    "runtime",
    "sync",
    "yjs"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/node_modules",
    "!dist/node_modules/**",
    "!dist/component/_virtual",
    "!dist/component/_virtual/**",
    "src/auth",
    "src/client/index.ts",
    "src/client/preload.ts",
    "src/codegen",
    "src/component",
    "src/crdt",
    "src/expo/metro.cjs",
    "src/expo/shims",
    "src/kernel/modules.ts",
    "src/server",
    "src/shared",
    "src/test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./tracing/browser": {
      "types": "./dist/tracing/browser.d.ts",
      "import": "./dist/tracing/browser.js",
      "default": "./dist/tracing/browser.js"
    },
    "./tracing/node": {
      "types": "./dist/tracing/node.d.ts",
      "import": "./dist/tracing/node.js",
      "default": "./dist/tracing/node.js"
    },
    "./tracing/memory": {
      "types": "./dist/tracing/memory.d.ts",
      "import": "./dist/tracing/memory.js",
      "default": "./dist/tracing/memory.js"
    },
    "./tracing/spans": {
      "types": "./dist/tracing/spans.d.ts",
      "import": "./dist/tracing/spans.js",
      "default": "./dist/tracing/spans.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "import": "./dist/expo/index.js",
      "default": "./dist/expo/index.js"
    },
    "./expo/metro": {
      "default": "./src/expo/metro.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js",
      "default": "./dist/unplugin.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./nitro": {
      "types": "./dist/nitro.d.ts",
      "import": "./dist/nitro.js",
      "default": "./dist/nitro.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js",
      "default": "./dist/codegen.js"
    },
    "./server": {
      "@convex-dev/component-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/table": {
      "types": "./dist/server/table.d.ts",
      "import": "./dist/server/table.js",
      "default": "./dist/server/table.js"
    },
    "./server/fields": {
      "types": "./dist/server/fields.d.ts",
      "import": "./dist/server/fields.js",
      "default": "./dist/server/fields.js"
    },
    "./server/schema": {
      "types": "./dist/server/schema.d.ts",
      "import": "./dist/server/schema.js",
      "default": "./dist/server/schema.js"
    },
    "./crdt": {
      "@convex-dev/component-source": "./src/crdt/index.ts",
      "types": "./dist/crdt/index.d.ts",
      "import": "./dist/crdt/index.js",
      "default": "./dist/crdt/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js",
      "default": "./dist/devtools/index.js"
    },
    "./devtools/vite": {
      "types": "./dist/devtools/vite.d.ts",
      "import": "./dist/devtools/vite.js",
      "default": "./dist/devtools/vite.js"
    },
    "./client": {
      "@convex-dev/component-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "import": "./dist/component/convex.config.js",
      "default": "./dist/component/convex.config.js"
    },
    "./test": {
      "@convex-dev/component-source": "./src/test.ts",
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp exec tsdown",
    "codegen": "vp exec convex codegen --component-dir ./src/component",
    "typecheck": "vp exec tsgo --noEmit",
    "typecheck:consumer": "vp exec tsc --project tsconfig.consumer.json --noEmit",
    "test": "vp run --filter tests test:embedded",
    "test:once": "vp run --filter tests test:embedded",
    "prepublishOnly": "vp run build && vp run typecheck:consumer"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "convex-helpers": "^0.1.0",
    "react-native-get-random-values": "^1.11.0",
    "unplugin": "^2.3.10",
    "wa-sqlite": "github:rhashimoto/wa-sqlite",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@tanstack/devtools": "^0.12.2",
    "@tanstack/devtools-vite": "^0.7.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.3.0",
    "convex": "catalog:",
    "convex-test": "^0.0.36",
    "solid-js": "^1.9.7",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@op-engineering/op-sqlite": ">=15",
    "@tanstack/db": ">=0.0.1",
    "@tanstack/devtools": ">=0.12.0",
    "@tanstack/devtools-vite": ">=0.7.0",
    "convex": "^1.37.0",
    "expo": ">=54",
    "expo-file-system": ">=19",
    "expo-network": ">=8",
    "react": ">=18",
    "react-native": ">=0.74",
    "solid-js": ">=1.9.7",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@op-engineering/op-sqlite": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "@tanstack/devtools": {
      "optional": true
    },
    "@tanstack/devtools-vite": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  }
}
