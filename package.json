{
  "name": "@robelest/convex-edge",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "demos/*"
    ],
    "catalog": {
      "convex": "^1.32.0",
      "tsdown": "^0.21.1",
      "typescript": "^5.9.0",
      "vitest": "^4.0.18"
    }
  },
  "scripts": {
    "test": "bun --filter @robelest/convex-edge-tests test:once",
    "build": "bun --filter @robelest/fx --filter @robelest/convex-embedded build",
    "build:fx": "bun --filter @robelest/fx build",
    "build:embedded": "bun --filter @robelest/convex-embedded build",
    "publish:fx": "npm publish --workspace packages/fx",
    "publish:embedded": "npm publish --workspace packages/convex-embedded",
    "typecheck": "bun --filter @robelest/fx --filter @robelest/convex-embedded typecheck",
    "typecheck:fx": "bun --filter @robelest/fx typecheck",
    "typecheck:embedded": "bun --filter @robelest/convex-embedded typecheck",
    "lint": "oxlint --fix",
    "fmt": "oxfmt .",
    "check": "oxlint && oxfmt --check .",
    "dev:convex": "bunx convex dev",
    "dev:svelte": "bun --filter demo-svelte dev"
  },
  "dependencies": {
    "convex": "^1.32.0"
  },
  "devDependencies": {
    "@convex-dev/action-retrier": "^0.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260311.1",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0"
  }
}
