{
  "name": "@robelest/convex-embedded",
  "version": "0.0.1",
  "description": "Embedded Convex runtime with offline-first sync for local-first applications.",
  "keywords": [
    "convex",
    "crdt",
    "embedded",
    "local-first",
    "offline-first",
    "runtime",
    "sync",
    "yjs"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./worker": {
      "types": "./dist/browser/wa-sqlite-worker.d.ts",
      "import": "./dist/browser/wa-sqlite-worker.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./crdt": {
      "types": "./src/crdt/index.ts",
      "import": "./src/crdt/index.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": {
        "@convex-dev/component-source": "./src/client/index.ts",
        "default": "./dist/client/index.js"
      }
    },
    "./convex.config": {
      "types": "./src/component/convex.config.ts",
      "import": "./src/component/convex.config.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "import": "./src/test.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "codegen": "vp exec convex codegen --component-dir ./src/component",
    "typecheck": "vp exec tsgo --noEmit",
    "test": "vp run --filter @robelest/embedded-tests test -- --project embedded",
    "test:once": "vp run --filter @robelest/embedded-tests test:once -- --project embedded",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@robelest/fx": "workspace:*",
    "convex-helpers": "^0.1.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "convex": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.32.0"
  }
}
