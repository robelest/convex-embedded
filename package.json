{
  "name": "embedded",
  "private": true,
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vp run cache:test",
    "test:coverage": "vp test --run --coverage",
    "build": "vp run cache:build",
    "build:fx": "vp run --filter @robelest/fx build",
    "build:embedded": "vp exec convex codegen --component-dir ./packages/convex-embedded/src/component && vp run --filter @robelest/convex-embedded build",
    "publish:fx": "vp pm publish --filter @robelest/fx --access public",
    "publish:embedded": "vp pm publish --filter @robelest/convex-embedded --access public",
    "typecheck": "vp run --filter @robelest/fx typecheck && vp run --filter @robelest/convex-embedded typecheck",
    "typecheck:fx": "vp run --filter @robelest/fx typecheck",
    "typecheck:embedded": "vp run --filter @robelest/convex-embedded typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "check": "vp run cache:check",
    "dev:convex": "vp exec convex dev",
    "dev:svelte": "vp run --filter demo-svelte dev",
    "prepare": "vp config"
  },
  "dependencies": {
    "convex": "catalog:"
  },
  "devDependencies": {
    "@convex-dev/action-retrier": "^0.3.0",
    "@robelest/convex-embedded": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260313.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "catalog:",
      "vitest": "catalog:"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    },
    "allowBuilds": {
      "esbuild": true
    }
  }
}
