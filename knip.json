{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["convex/**/*.ts"],
      "project": ["convex/**/*.ts"]
    },
    "packages/convex-embedded": {
      "entry": ["src/component/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tests": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "benchmarks": {
      "entry": ["**/*.bench.ts"],
      "project": ["**/*.ts"]
    },
    "demos/svelte": {
      "entry": [
        "src/routes/**/+page.svelte",
        "src/routes/**/+layout.svelte"
      ],
      "project": ["src/**/*.{ts,svelte}"]
    },
    "demos/expo": {
      "entry": ["app/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "docs": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "include": ["namespaceMembers"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
