{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "$convex/_generated/embedded": ["./src/generated/embedded.ts"],
      "$convex/*": ["../../convex/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../convex/**/*.ts",
    "../../convex/**/*.d.ts"
  ]
}
