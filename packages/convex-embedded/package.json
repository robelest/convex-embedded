{
  "name": "@robelest/convex-embedded",
  "version": "0.0.1",
  "description": "Embedded Convex runtime with offline-first sync for local-first applications.",
  "keywords": [
    "convex",
    "crdt",
    "embedded",
    "local-first",
    "offline-first",
    "runtime",
    "sync",
    "yjs"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "import": "./dist/expo/index.js",
      "default": "./dist/expo/index.js"
    },
    "./expo/metro": {
      "default": "./src/expo/metro.cjs"
    },
    "./server": {
      "@convex-dev/component-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/table": {
      "types": "./dist/server/table.d.ts",
      "import": "./dist/server/table.js",
      "default": "./dist/server/table.js"
    },
    "./server/fields": {
      "types": "./dist/server/fields.d.ts",
      "import": "./dist/server/fields.js",
      "default": "./dist/server/fields.js"
    },
    "./server/schema": {
      "types": "./dist/server/schema.d.ts",
      "import": "./dist/server/schema.js",
      "default": "./dist/server/schema.js"
    },
    "./crdt": {
      "@convex-dev/component-source": "./src/crdt/index.ts",
      "types": "./dist/crdt/index.d.ts",
      "import": "./dist/crdt/index.js",
      "default": "./dist/crdt/index.js"
    },
    "./client": {
      "@convex-dev/component-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./test": {
      "@convex-dev/component-source": "./src/test.ts",
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp exec tsdown",
    "codegen": "vp exec convex codegen --component-dir ./src/component",
    "typecheck": "vp exec tsgo --noEmit",
    "typecheck:consumer": "vp exec tsc --project tsconfig.consumer.json --noEmit",
    "test": "vp run --filter tests test:embedded",
    "test:once": "vp run --filter tests test:embedded",
    "prepublishOnly": "vp run build && vp run typecheck:consumer"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@robelest/fx": "0.0.1-preview.4",
    "convex-helpers": "^0.1.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "convex": "catalog:",
    "convex-test": "^0.0.36",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.34.1",
    "expo": ">=54",
    "expo-crypto": ">=15",
    "expo-file-system": ">=19",
    "expo-network": ">=8",
    "expo-sqlite": ">=16",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
