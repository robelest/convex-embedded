{
  "name": "@robelest/convex-edge",
  "private": true,
  "workspaces": {
    "packages": ["packages/*", "demos/*"],
    "catalog": {
      "convex": "^1.17.0",
      "vitest": "^4.0.18",
      "typescript": "^5.9.0"
    }
  },
  "scripts": {
    "test": "bun --filter @robelest/convex-edge-tests test:once",
    "build": "bun --filter @robelest/convex-resolve --filter @robelest/convex-embedded build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "dev:convex": "bunx convex dev",
    "dev:tanstack": "bun run --filter demo-tanstack-start dev"
  },
  "dependencies": {
    "convex": "^1.32.0",
    "@robelest/convex-resolve": "workspace:*"
  },
  "devDependencies": {
    "@convex-dev/action-retrier": "^0.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260308.1",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0"
  }
}
