{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["../packages/convex-embedded/src/*"],
      "@embedded/*": ["../packages/convex-embedded/src/*"],
      "@resolve/*": ["../packages/convex-embedded/src/*"],
      "@convex/*": ["../convex/*"]
    }
  },
  "include": ["**/*.test.ts"],
  "exclude": ["node_modules"]
}
